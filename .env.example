# ==============================================================================
# VERITY — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure your local environment:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY GUIDELINES:
# 1. Never commit .env.local or any file containing real secret keys to Git.
# 2. NEXT_PUBLIC_* variables are exposed to the browser.
# 3. SUPABASE_SERVICE_ROLE_KEY is server-only. NEVER prefix it with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon Key (Public key safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Server-Only Supabase Service Role Key (Used strictly in server API routes for privileged operations)
# DO NOT EXPOSE TO BROWSER.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 2. Privileged Moderation Security (Server-side only)
# ------------------------------------------------------------------------------
# Secret token required to authorize privileged operations (approve, reject)
# If omitted during local development, fallback developer token 'dev-verity-local-2026' is accepted.
MODERATOR_API_SECRET=your-secure-moderator-secret-key-change-in-prod

# ------------------------------------------------------------------------------
# 3. Optional AI Research Engine Keys (Server-side only)
# ------------------------------------------------------------------------------
# If omitted, VERITY automatically uses its deterministic evidentiary research engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

